# SQUADLY production environment — copy to .env and fill in.

# Node / server
NODE_ENV=production
PORT=5000

# SQLite database file. In Docker this points at the mounted volume (/data).
DB_PATH=backend/data/squadly.db

# JWT signing secret — MUST be a long random string in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Frontend origin allowed by CORS (leave as-is when the backend serves the SPA itself).
FRONTEND_URL=http://localhost:3000

# Optional: override where the built frontend is served from (default: frontend/dist).
# DIST_DIR=/app/frontend/dist

# --- Payments ---
# Provider for wallet top-ups. 'mock' (default) never takes real money.
# Set to 'stripe' for a live gateway, and install the SDK: npm i stripe
PAYMENT_PROVIDER=mock
# STRIPE_SECRET_KEY=sk_live_...

